@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "Manage Results";
}

<div class="container mt-5">
    <h2 class="mb-4">Race Results Management</h2>

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    <a asp-controller="Organiser"
       asp-action="RecordResult"
       class="btn btn-success mb-3">
        + Record New Result
    </a>


    <div class="card shadow">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p>No results have been recorded yet.</p>
            }
            else
            {
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Result ID</th>
                            <th>Enrolment ID</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td>@result.ResultId</td>
                                <td>@result.EnrolmentId</td>
                                <td>@result.FinishTime</td>
                                <td>@result.Position</td>
                                <td>@result.ResultStatus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
