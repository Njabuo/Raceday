@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
    var fullName = Context.Session.GetString("FullName") ?? "Organiser";
}

<div class="container mt-5">

    <div class="p-5 mb-4 bg-dark text-white rounded-3">
        <h1 class="display-5 fw-bold">Organiser Dashboard</h1>
        <p class="fs-5">Welcome, @fullName.</p>
        <p>Manage your race events, categories, participants and results.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    <div class="mb-4 d-flex flex-wrap gap-2">
        <a asp-action="CreateEvent" class="btn btn-primary">Create Event</a>
        <a asp-action="CreateCategory" class="btn btn-success">Create Category</a>
        <a asp-action="Enrolments" class="btn btn-info">View Enrolments</a>
        <a asp-action="Results" class="btn btn-warning">Manage Results</a>
    </div>

    <h2 class="mb-3">Your Race Events</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow h-100">

                        @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageBlobName))
                        {
                            <img src="@Url.Action("EventBanner", "Organiser", new { id = raceEvent.EventId })"
                                 class="card-img-top"
                                 alt="@raceEvent.EventName banner"
                                 style="height:200px; object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">@raceEvent.EventName</h5>

                            <p class="card-text">
                                <strong>Date:</strong> @raceEvent.EventDate
                                <br />
                                <strong>Location:</strong> @raceEvent.Location
                                <br />
                                <strong>Status:</strong> @raceEvent.Status
                            </p>

                            <p>@raceEvent.Description</p>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@raceEvent.EventId"
                                   class="btn btn-primary">
                                    Edit
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteEvent"
                                      asp-route-id="@raceEvent.EventId"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-dark">Logout</button>
        </form>
    </div>

</div>