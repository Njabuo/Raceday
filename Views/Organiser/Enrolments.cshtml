@model List<RaceDay.MVC.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Participant Enrolments";
}

<div class="container mt-5">

    <h2 class="mb-4">Participant Enrolments</h2>

    <div class="card shadow p-4">

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No participant enrolments found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Enrolment ID</th>
                            <th>Participant ID</th>
                            <th>Category ID</th>
                            <th>Enrolment Date</th>
                            <th>Status</th>
                            <th>Race Number</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enrolment in Model)
                        {
                            <tr>
                                <td>@enrolment.EnrolmentId</td>
                                <td>@enrolment.ParticipantId</td>
                                <td>@enrolment.CategoryId</td>
                                <td>@enrolment.EnrolmentDate</td>
                                <td>@enrolment.Status</td>
                                <td>@enrolment.RaceNumber</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

        <a asp-action="Dashboard"
           class="btn btn-secondary mt-3">
            Back to Dashboard
        </a>

    </div>
</div>