@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-5">

    <h1 class="mb-4">My Race Enrolments</h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any race categories yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Category ID</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Race Number</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EnrolmentId</td>
                            <td>@enrolment.CategoryId</td>
                            <td>@enrolment.EnrolmentDate.ToString("dd MMMM yyyy")</td>
                            <td>@enrolment.Status</td>
                            <td>@enrolment.RaceNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>