@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-5">

    <h1 class="mb-4">My Race Results</h1>

    <p class="text-muted">
        View your race performance and finishing positions.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race results are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Result Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultId</td>
                            <td>@result.EnrolmentId</td>
                            <td>@result.FinishTime</td>
                            <td>@result.Position</td>
                            <td>@result.ResultStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>