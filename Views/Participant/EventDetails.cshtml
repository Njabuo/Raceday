@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
    var categories = ViewBag.Categories as List<RaceDay.MVC.Models.CategoryViewModel>
                     ?? new List<RaceDay.MVC.Models.CategoryViewModel>();
}

<div class="container mt-5">

    <a asp-controller="Home" asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        &larr; Back to Dashboard
    </a>

    <div class="card shadow">

        @if (!string.IsNullOrWhiteSpace(Model.BannerImageBlobName))
        {
            <img src="@Url.Action("EventBanner", "Participant", new { id = Model.EventId })"
                 class="card-img-top"
                 alt="@Model.EventName banner"
                 style="height:300px; object-fit:cover;" />
        }

        <div class="card-body p-4">

            <h1 class="fw-bold">@Model.EventName</h1>

            <hr />

            <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <h4 class="mt-4">About This Event</h4>
            <p>@(Model.Description ?? "No description available.")</p>

            <hr />

            <h3 class="mb-3">Available Race Categories</h3>

            @if (!categories.Any())
            {
                <div class="alert alert-info">
                    No race categories have been added to this event yet.
                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var category in categories)
                    {
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="card-body">

                                    <h5>@category.CategoryName</h5>

                                    <p>
                                        <strong>Distance:</strong>
                                        @category.DistanceKm km
                                    </p>

                                    <p>
                                        <strong>Maximum Participants:</strong>
                                        @category.MaximumParticipants
                                    </p>

                                    <form asp-controller="Participant"
                                          asp-action="Enrol"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="categoryId"
                                               value="@category.CategoryId" />

                                        <button type="submit"
                                                class="btn btn-success">
                                            Enrol Now
                                        </button>

                                    </form>

                                </div>
                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    </div>

</div>
