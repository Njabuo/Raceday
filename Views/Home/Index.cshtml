@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Participant Dashboard";
    var fullName = Context.Session.GetString("FullName") ?? "Participant";
}

<div class="container mt-5">

    <div class="p-5 mb-4 bg-dark text-white rounded-3">
        <h1 class="display-5 fw-bold">Welcome to RaceDay!</h1>
        <p class="fs-5">Hello, @fullName.</p>
        <p>Discover races, manage your enrolments and track your results.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <h2 class="mb-3">Find Your Next Race</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Home" asp-action="Index" method="get">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Event Name</label>
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search race name..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Location</label>
                        <input type="text"
                               name="location"
                               value="@ViewBag.Location"
                               class="form-control"
                               placeholder="Enter location..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Event Date</label>
                        <input type="date"
                               name="eventDate"
                               value="@ViewBag.EventDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Search
                        </button>
                    </div>

                </div>

                <div class="mt-3">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-sm">
                        Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <h2 class="mb-4">Available Race Events</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events match your search. Try changing your filters.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var raceEvent in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow h-100">

                        @if (!string.IsNullOrWhiteSpace(raceEvent.BannerImageBlobName))
                        {
                            <img src="@Url.Action("EventBanner", "Participant", new { id = raceEvent.EventId })"
                                 class="card-img-top"
                                 alt="@raceEvent.EventName banner"
                                 style="height: 200px; object-fit: cover;" />
                        }

                        <div class="card-body">
                            <h4 class="card-title">@raceEvent.EventName</h4>

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Status:</strong>
                                @raceEvent.Status
                            </p>

                            <p>
                                @(raceEvent.Description ?? "No description available.")
                            </p>

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@raceEvent.EventId"
                               class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-5">
        <h2>My RaceDay Activities</h2>

        <div class="row g-4 mt-1">

            <div class="col-md-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4>My Enrolments</h4>
                        <p>View your registered events and enrolment status.</p>
                        <a asp-controller="Participant" asp-action="MyEnrolments"
                           class="btn btn-primary">View My Enrolments</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4>Race Categories</h4>
                        <p>Explore available race distances and choose your category.</p>
                        <a asp-controller="Participant" asp-action="Categories"
                           class="btn btn-primary">View Categories</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4>My Results</h4>
                        <p>Track your race performance and finishing positions.</p>
                        <a asp-controller="Participant" asp-action="MyResults"
                           class="btn btn-primary">View My Results</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4>My Profile</h4>
                        <p>View and update your personal information.</p>
                        <a asp-controller="Participant" asp-action="Profile"
                           class="btn btn-primary">Manage Profile</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="mt-5 mb-4">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>

</div>
